# The dashboard and personal store work without a model connection.
AGENT_RUNTIME=docker
# Optional explicit Windows-to-WSL Docker target. Omit for native Docker CLI.
# AGENT_DOCKER_WSL_DISTRO=Ubuntu-22.04
# Explicitly approved inner Codex namespace profile; default keeps Docker's policy.
# Verified only on Docker 29.1.3/amd64. See worker/security/README.md.
AGENT_DOCKER_SANDBOX=default
AGENT_PERSIST_WORKSPACES=true
AGENT_IMAGE=agent-company-worker:0.1.0
# Optional isolated static-preview browser; set only after image/profile verification.
# AGENT_BROWSER_IMAGE=sha256:<verified-64-character-image-id>
# Uses worker/security/browser-userns.json, never the Codex worker profile.
AGENT_MODEL=gpt-6-astra
# none | codex | api-key. Choosing codex uses a temporary per-run auth copy.
AGENT_AUTH=none
# AGENT_CODEX_AUTH_FILE=C:/Users/your-name/.codex/auth.json
# OPENAI_API_KEY=
AGENT_TIMEOUT_SECONDS=900
AGENT_MEMORY_BUDGET_MIB=3072
AGENT_CPU_BUDGET=4
AGENT_WORKER_MIN_MEMORY_MIB=1024
AGENT_WORKER_MIN_CPUS=1
AGENT_WORKER_MAX_MEMORY_MIB=2048
AGENT_WORKER_MAX_CPUS=2
AGENT_DATA_DIR=.data
# Opt-in owned local backup directory; models and credentials are not archived.
AGENT_STORAGE_ENABLED=false
# AGENT_BACKUP_DIR=C:/dev/backups/agent-company
AGENT_DATA_BUDGET_GIB=10
AGENT_BACKUP_BUDGET_GIB=30
AGENT_STORAGE_TEMP_GIB=10
AGENT_DISK_MIN_FREE_GIB=20
# Optional host-only GitHub App connection. All four fields are required.
# Install on selected repositories only: Contents/Pull requests read & write, Metadata read.
# Keep the PEM outside this workspace, managed data/backups and worker-visible paths.
# The example path is a placeholder; use an OS-private directory and owner-only permissions.
# AGENT_GITHUB_APP_ID=
# AGENT_GITHUB_INSTALLATION_ID=
# AGENT_GITHUB_PRIVATE_KEY_FILE=C:/Users/your-name/AppData/Local/agent-company/secrets/github-app.pem
# AGENT_GITHUB_REPOSITORIES=owner/repository
PORT=4310
# Kubernetes is opt-in; specify the exact context and existing namespace/Secret.
# AGENT_K8S_CONTEXT=
# AGENT_K8S_NAMESPACE=agent-company
# AGENT_K8S_AUTH_SECRET=agent-model-auth

{
  "name": "agent-company",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently --raw -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:desktop": "tsx scripts/build-desktop.ts",
    "build:desktop-native": "tsx scripts/build-desktop-native.ts",
    "build:desktop-worker": "tsx scripts/build-desktop-worker.ts",
    "verify:desktop-codex": "tsx scripts/desktop-codex-package.ts",
    "stage:desktop": "tsx scripts/stage-desktop-native.ts",
    "build:desktop-installer": "tsx scripts/build-desktop-installer.ts",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "doctor": "tsx scripts/doctor.ts",
    "release": "tsx scripts/release.ts",
    "worker:build": "tsx scripts/build-worker.ts",
    "smoke:runtime": "tsx scripts/smoke-runtime.ts",
    "smoke:collaboration": "tsx scripts/smoke-collaboration.ts",
    "smoke:storage": "tsx scripts/smoke-storage.ts",
    "smoke:growth": "tsx scripts/smoke-growth.ts",
    "verify:sandbox": "tsx scripts/verify-sandbox.ts",
    "test": "tsx --test --test-concurrency=4 tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fastify/static": "10.1.3",
    "fastify": "5.12.3",
    "lucide-react": "1.41.0",
    "proper-lockfile": "^4.1.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "agent-browser": "^0.36.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
